{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run build)",
      "Bash(npm run build:*)",
      "Bash(npm run test:unit)",
      "Bash(npm run test:unit:*)",
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm run format)",
      "Bash(npm run format:check)",
      "Bash(npx ng generate:*)",
      "Bash(ng generate:*)",
      "Bash(npx prettier --check:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(git branch --list:*)",
      "Bash(git branch --show-current)",
      "Bash(pre-commit run:*)",
      "Bash(gitleaks git:*)",
      "Bash(gitleaks dir:*)",
      "Bash(sh scripts/verificar-titulo.sh:*)",
      "mcp__tracker__list_issues",
      "mcp__tracker__get_issue",
      "mcp__tracker__next_issue",
      "mcp__tracker__report_status"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(firebase deploy:*)",
      "Bash(npx firebase-tools deploy:*)",
      "Bash(npm run deploy:*)",
      "Bash(git push:*)",
      "Bash(docker push:*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.p12)",
      "Read(./**/*.jks)",
      "Read(./**/*.keystore)",
      "Read(./**/*-adminsdk-*.json)"
    ]
  }
}
