{%- if i18n -%}
{%- raw -%}
<article class="vrb-card item-detail">
  <a class="item-detail__back" routerLink="..">← {{ 'items.detail.back' | translate }}</a>

  @if (store.selected(); as item) {
    <h1 class="item-detail__title">{{ item.name }}</h1>
    <p class="vrb-card__description">{{ item.description }}</p>
    <p class="item-detail__meta">
      {{ 'items.status.' + item.status | translate }} · {{ item.updatedAt | date: 'medium' }}
    </p>
  } @else if (store.selectedLoading()) {
    <p class="item-detail__meta">{{ 'common.loading' | translate }}</p>
  } @else if (store.selectedError()) {
    <div class="vrb-alert vrb-alert--danger" role="alert">
      <div class="vrb-alert__body">
        <p class="vrb-alert__description">{{ 'items.detail.notFound' | translate }}</p>
      </div>
    </div>
  }
</article>
{%- endraw -%}
{%- else -%}
{%- raw -%}
<article class="vrb-card item-detail">
  <a class="item-detail__back" routerLink="..">← Volver al listado</a>

  @if (store.selected(); as item) {
    <h1 class="item-detail__title">{{ item.name }}</h1>
    <p class="vrb-card__description">{{ item.description }}</p>
    <p class="item-detail__meta">Actualizado: {{ item.updatedAt | date: 'medium' }}</p>
  } @else if (store.selectedLoading()) {
    <p class="item-detail__meta">Cargando…</p>
  } @else if (store.selectedError()) {
    <div class="vrb-alert vrb-alert--danger" role="alert">
      <div class="vrb-alert__body">
        <p class="vrb-alert__description">No encontramos este ítem.</p>
      </div>
    </div>
  }
</article>
{%- endraw -%}
{%- endif %}
