import { DatePipe } from '@angular/common';
import { ChangeDetectionStrategy, Component, effect, inject, input } from '@angular/core';
import { RouterLink } from '@angular/router';
{%- if i18n %}
import { TranslatePipe } from '@ngx-translate/core';
{%- endif %}

import { ShellNav } from '@/app/layout/shell/shell-nav';
import { ItemsStore } from '../../data-access/items.store';

@Component({
  selector: 'app-item-detail',
  imports: [RouterLink, DatePipe{% if i18n %}, TranslatePipe{% endif %}],
  templateUrl: './item-detail.html',
  styleUrl: './item-detail.scss',
  changeDetection: ChangeDetectionStrategy.OnPush,
})
export class ItemDetail {
  protected readonly store = inject(ItemsStore);
  private readonly nav = inject(ShellNav);

  /** Viene del path `:id` (withComponentInputBinding en app.config.ts). */
  readonly id = input.required<string>();

  constructor() {
    // Cada vez que cambia el id de la URL, el store carga ese item.
    effect(() => this.store.select(this.id()));
    // Migas del shell: Ítems › <nombre del ítem> (cuando ya cargó).
    effect(() => {
      const item = this.store.selected();
      const list = {% if i18n %}{ label: 'items.list.title', translate: true, link: ['/items'] }{% else %}{ label: 'Ítems', link: ['/items'] }{% endif %};
      this.nav.set(item ? [list, { label: item.name }] : [list]);
    });
  }
}
