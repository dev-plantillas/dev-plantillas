{%- if i18n -%}
{%- raw -%}
<main class="login">
  <form class="vrb-card login__card" [formGroup]="form" (ngSubmit)="submit()">
    <h1 class="vrb-card__title">{{ 'auth.login.title' | translate }}</h1>

    <div class="vrb-field">
      <label class="vrb-field__label" for="login-email">{{ 'auth.login.email' | translate }}</label>
      <input
        class="vrb-input"
        id="login-email"
        type="email"
        formControlName="email"
        autocomplete="email"
      />
    </div>

    <div class="vrb-field">
      <label class="vrb-field__label" for="login-password">{{
        'auth.login.password' | translate
      }}</label>
      <input
        class="vrb-input"
        id="login-password"
        type="password"
        formControlName="password"
        autocomplete="current-password"
      />
    </div>

    @if (failed()) {
      <div class="vrb-alert vrb-alert--danger" role="alert">
        <div class="vrb-alert__body">
          <p class="vrb-alert__description">{{ 'auth.login.error' | translate }}</p>
        </div>
      </div>
    }

    <ui-button type="submit" [loading]="loading()" [disabled]="form.invalid" [fullWidth]="true">
      {{ 'auth.login.submit' | translate }}
    </ui-button>
  </form>
</main>
{%- endraw -%}
{%- else -%}
<main class="login">
  <form class="vrb-card login__card" [formGroup]="form" (ngSubmit)="submit()">
    <h1 class="vrb-card__title">Iniciar sesión</h1>

    <div class="vrb-field">
      <label class="vrb-field__label" for="login-email">Email</label>
      <input
        class="vrb-input"
        id="login-email"
        type="email"
        formControlName="email"
        autocomplete="email"
      />
    </div>

    <div class="vrb-field">
      <label class="vrb-field__label" for="login-password">Contraseña</label>
      <input
        class="vrb-input"
        id="login-password"
        type="password"
        formControlName="password"
        autocomplete="current-password"
      />
    </div>

    @if (failed()) {
      <div class="vrb-alert vrb-alert--danger" role="alert">
        <div class="vrb-alert__body">
          <p class="vrb-alert__description">No pudimos iniciar sesión. Revisa tus datos.</p>
        </div>
      </div>
    }

    <ui-button type="submit" [loading]="loading()" [disabled]="form.invalid" [fullWidth]="true">
      Entrar
    </ui-button>
  </form>
</main>
{%- endif %}
