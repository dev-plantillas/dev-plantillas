# Verificación en cada PR y en cada push a main: lint + unit tests + build.
name: CI

on:
  pull_request:
  push:
    branches: [main]

concurrency:
  group: ci-{% raw %}${{ github.ref }}{% endraw %}
  cancel-in-progress: true

permissions:
  contents: read
  packages: read # design system @vrojas1015/vrb en GitHub Packages

jobs:
  verify:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 24
          cache: npm
      - run: npm ci
        env:
          # Design system vrb desde GitHub Packages (.npmrc). NPM_TOKEN: token clásico
          # con read:packages; sin él se intenta con el GITHUB_TOKEN del workflow (sólo
          # alcanza si el paquete le dio acceso a este repo).
          NODE_AUTH_TOKEN: {% raw %}${{ secrets.NPM_TOKEN || secrets.GITHUB_TOKEN }}{% endraw %}
      - run: npm run lint
      - run: npm run test:unit
      - run: npm run build:prod
